# Copy to .env and chmod 600:
#   cp -n dotenv.sample .env && chmod 600 .env
#
# HOST_ROLE selects which Pi this checkout is:
#   solar-broker — Victron BLE (+ optional Sungold). Do not run this role on .
#   monitor — house AdGuard DNS + Theengs BLE gateway to Mosquitto on 
# If unset, deploy.sh uses monitor when the LAN IP is solar-broker, otherwise solar-broker.
# Never run deploy.sh on solar-broker (apps VM).
# HOST_ROLE=solar-broker

# MQTT broker settings for Mosquitto, Home Assistant, Theengs, and victron_ble2mqtt.
# Every client MUST use this same host — including the HA MQTT integration.
# On HOST_ROLE=monitor this MUST be the  broker (solar-broker), not this Pi.
# On HOST_ROLE=solar-broker with Mosquitto+HA on the Pi, use this Pi's LAN IP (not a second broker).

MQTT_HOST=solar-broker
MQTT_PORT=1883
MQTT_USER=user
MQTT_PASSWORD=your_secure_password_here

# Optional: pin / override Home Assistant image (default set in docker-compose.homeassistant.yml)
# HA_IMAGE=ghcr.io/home-assistant/home-assistant:2026.7.3
# EcoNet on HA 2026.7+: run scripts/ha_econet_trust_g1.sh then:
# HA_SSL_CERT_FILE=/config/ssl/ca-bundle+g1.pem

# Optional BLE adapter (bluetoothctl list). Default is BlueZ default (usually hci0).
# BLE_ADAPTER=hci0
#
# Pi 4 solar-site Theengs is OFF by default. Victron owns the onboard adapter.
# BlueZ: one StartDiscovery session per client per adapter
# (https://manpages.ubuntu.com/manpages/noble/man5/org.bluez.Adapter.5.html).
# Theengs docs are silent on sharing one HCI with another scanner.
# Default off (Victron keeps onboard HCI):
# ENABLE_solar-broker_THEENGS=0
# Opt-in only with a second adapter (USB dongle), then:
# ENABLE_solar-broker_THEENGS=1
# THEENGS_ADAPTER=hci1
# Then sudo bash scripts/deploy.sh (profile solar-theengs).
# See docs/DEVICES.md. Do not docker compose up theengs-gateway on hci0.

# Timezone for Home Assistant
TZ=America/Chicago

# Wi-Fi failover (optional)
# WIFI_SSID=
# WIFI_PASSWORD=

# ADVKEY_* device advertisement keys: prefer ./victron-secrets.env (chmod 600).
# If the same variable is set in both files, .env wins (see scripts/redeploy_victron.sh).

# Device on/off — see docs/DEVICES.md
# ENABLE_HOME_ASSISTANT=1
# --- Sungold SPH302480A (optional read-only Modbus sidecar) ---
# ENABLE_SUNGOLD=0
# SUNGOLD_SERIAL_DEVICE=/dev/sungold
# MODBUS_ADDRESS=1
# MODBUS_BAUDRATE=9600
# MQTT_TOPIC=sungold-inverter-1
# DEVICE_NAME=Sungold SPH302480A
# POLL_INTERVAL_SEC=5
# MODBUS_TIMEOUT=1.0
# --- BMS supervisor (optional read-only VE.Direct shunt sidecar) ---
# ENABLE_BMS_SUPERVISOR=0
# BMS_SERIAL_DEVICE=/dev/vedirect
# BMS_ADAPTER=generic_shunt
# BMS_BANK_ID=bench
# BMS_MQTT_TOPIC=bms_supervisor
# BMS_DEVICE_NAME=Bench shunt
